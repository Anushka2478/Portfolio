---
import '../styles/global.css';
import { url } from '../lib/asset';
import Key from '../components/Key.astro';
interface Props { title: string; description: string; status?: string; jsonld?: object }
const { title, description, status = 'Lucknow · tour in progress', jsonld } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url('og.png'), Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Silkscreen&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="os-bar" aria-hidden="true">
      <span class="brand">ANUSHKA.OS</span>
      <span class="menu"><span>File</span><span>Edit</span><span>View</span><span>Go</span><span>Help</span></span>
      <span class="status">{status}</span>
    </div>
    <slot name="header" />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span class="brand">ANUSHKA.OS</span>
      <span>Designed by Anushka Srivastava · Lucknow, India</span>
    </footer>
    <div class="scroll-rail" aria-hidden="true"><span class="scroll-rail__thumb"></span></div>
    <Key label="↑" fn="TOP" class="go-up" aria-label="Back to top" data-go-up />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
