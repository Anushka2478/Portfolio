---
// Mechanical keycap. Renders an <a> when href is set, otherwise a <button>.
interface Props { label: string; fn?: string; tone?: 'neutral' | 'yellow' | 'blue' | 'red'; href?: string; external?: boolean; size?: 'md' | 'sm'; class?: string; [key: string]: any }
const { label, fn, tone = 'neutral', href, external = false, size = 'md', class: cls, ...rest } = Astro.props;
const classes = ['key', tone !== 'neutral' && `key--${tone}`, size === 'sm' && 'key--sm', cls];
const Tag = href ? 'a' : 'button';
const extra = href ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) } : { type: 'button' };
---
<Tag class:list={classes} {...extra} {...rest}>
  <span class="key__cap">
    {fn && <span class="key__fn" aria-hidden="true">{fn}</span>}
    <span class="key__label">{label}</span>
    {external && <span class="sr-only"> (opens in a new tab)</span>}
  </span>
</Tag>
