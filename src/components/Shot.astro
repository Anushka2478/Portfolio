---
// A real screen inside a phone, website-on-phone or browser frame.
import { url, hasAsset, parseShot } from '../lib/asset';
interface Props { app: string; shot: string; platform: 'phone' | 'browser'; title?: string; domain?: string; width?: number; eager?: boolean; caption?: boolean }
const { app, shot, platform, title, domain = '', width, eager = false, caption = true } = Astro.props;
const { kind, key } = parseShot(shot, platform);
const src = `assets/${app}/${key}.webp`;
const exists = hasAsset(src);
const alt = title ? `${title} screen` : `${app} screen`;
const w = width ?? (kind === 'browser' ? 640 : 300);
---
<figure class="device" style={`width:${w}px;max-width:100%`}>
  {kind === 'browser' ? (
    <div class="browser">
      <div class="browser__bar" aria-hidden="true"><span class="window__dots"><span></span><span></span><span></span></span><span class="browser__url">{domain}</span></div>
      <div class="browser__screen">{exists ? <img src={url(src)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="1400" height="875" /> : <div class="img-missing">{key}</div>}</div>
    </div>
  ) : (
    <div class:list={['phone', kind === 'phoneweb' && 'phone--web']}>
      <div class="phone__screen">
        {kind === 'phoneweb' && <div class="phone__status" aria-hidden="true">9:41</div>}
        {kind === 'phoneweb' && <div class="phone__url" aria-hidden="true">🔒 {domain}</div>}
        {exists ? <img src={url(src)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="780" height="1688" /> : <div class="img-missing">{key}</div>}
      </div>
    </div>
  )}
  {caption && title && <figcaption>{title}</figcaption>}
</figure>
