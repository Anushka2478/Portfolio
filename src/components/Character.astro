---
// Anushka — drawn from her photo. Three expressions share one body:
// follow (pupils track the pointer), baby (Creativity hover) and happy (Please Click hover).
interface Props { size?: number; expression?: 'follow' | 'baby' | 'happy'; interactive?: boolean; label?: string }
const { size = 400, expression = 'follow', interactive = false, label = 'Illustration of Anushka smiling, with long dark hair, pearl earrings and a red dress' } = Astro.props;
const SK = '#D9A27F', SKS = '#BC8461', H = '#2B1E19', HL = '#4B3329', D = '#D62839', DS = '#AD1E2C', L = '#A9433D', BL = '#F09A96', W = '#FFFFFF', PL = '#CFC8BD', INK = '#1C1F26';
const O = `stroke="${INK}" stroke-width="2.5" stroke-linejoin="round"`;
const ear = (x: number) => [252, 266, 283, 304].map((y, i) => `<circle cx="${x}" cy="${y}" r="${[4, 5, 6.5, 8.5][i]}" fill="${W}" stroke="${PL}" stroke-width="1.5"/>`).join('');
const brows = (y: number) => `<path class="brows" d="M146 ${y + 10} Q166 ${y} 186 ${y + 6} M214 ${y + 6} Q234 ${y} 254 ${y + 10}" stroke="${H}" stroke-width="4.5" stroke-linecap="round" fill="none"/>`;
const body = `
<path d="M200 48 C122 48 84 104 82 180 C80 256 76 336 60 426 C88 446 128 446 154 432 L246 432 C272 446 312 446 340 426 C324 336 320 256 318 180 C316 104 278 48 200 48 Z" fill="${H}" ${O}/>
<path d="M300 356 C320 406 328 456 330 520" stroke="${INK}" stroke-width="43" stroke-linecap="round" fill="none"/><path d="M300 356 C320 406 328 456 330 520" stroke="${D}" stroke-width="38" stroke-linecap="round" fill="none"/>
<path d="M92 520 C88 426 106 358 148 340 C166 332 184 330 200 330 C216 330 234 332 252 340 C294 358 312 426 308 520 Z" fill="${D}" ${O}/>
<path d="M238 348 C264 362 278 404 282 466" stroke="${DS}" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.6"/>
<path d="M120 352 C84 380 52 420 50 450 C48 474 70 484 94 478 L144 488" stroke="${INK}" stroke-width="43" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
<path d="M120 352 C84 380 52 420 50 450 C48 474 70 484 94 478 L144 488" stroke="${D}" stroke-width="38" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
<ellipse cx="152" cy="488" rx="17" ry="13" fill="${SK}" ${O}/>
<path d="M174 264 L174 332 C186 346 214 346 226 332 L226 264 Z" fill="${SK}" ${O}/>
<path d="M174 284 C190 300 210 300 226 284 L226 270 L174 270 Z" fill="${SKS}" opacity="0.55"/>
<path d="M164 330 C174 356 226 356 236 330 Z" fill="${SK}" ${O}/>
<ellipse cx="200" cy="188" rx="82" ry="88" fill="${SK}" ${O}/>
<g class="hair-front">
<path d="M114 180 C108 96 154 60 200 60 C246 60 292 96 286 180 C272 130 240 100 200 96 C160 100 128 130 114 180 Z" fill="${H}" ${O}/>
<path d="M200 96 C160 100 126 128 116 172 C108 214 108 262 96 330 C90 358 84 384 88 404 C110 374 118 330 122 288 C124 250 120 214 124 186 C130 146 162 112 200 96 Z" fill="${H}" ${O}/>
<path d="M200 96 C240 100 274 128 284 172 C292 214 292 262 304 330 C310 358 316 384 312 404 C290 374 282 330 278 288 C276 250 280 214 276 186 C270 146 238 112 200 96 Z" fill="${H}" ${O}/>
<path d="M200 62 L200 96" stroke="${HL}" stroke-width="3" stroke-linecap="round"/>
<path d="M108 230 C104 270 100 310 92 350 M292 230 C296 270 300 310 308 350 M168 74 C148 84 130 104 122 130 M232 74 C252 84 270 104 278 130" stroke="${HL}" stroke-width="3" stroke-linecap="round" fill="none"/>
</g>
${ear(128)}${ear(272)}
<path d="M200 198 C194 216 196 224 205 226" stroke="${SKS}" stroke-width="3" stroke-linecap="round" fill="none"/>`;
const follow = `${brows(148)}
<g class="eye-whites"><path d="M150 190 Q168 176 186 188 Q170 200 150 190 Z" fill="${W}" ${O}/><path d="M214 188 Q232 176 250 190 Q230 200 214 188 Z" fill="${W}" ${O}/></g>
<g class="pupils"><circle cx="171" cy="189" r="7.5" fill="${H}"/><circle cx="233" cy="189" r="7.5" fill="${H}"/><circle cx="173" cy="186" r="2.4" fill="${W}"/><circle cx="235" cy="186" r="2.4" fill="${W}"/></g>
<ellipse cx="148" cy="226" rx="14" ry="7" fill="${BL}" opacity="0.55"/><ellipse cx="252" cy="226" rx="14" ry="7" fill="${BL}" opacity="0.55"/>
<path d="M168 238 Q200 274 232 238 Q200 251 168 238 Z" fill="${L}" ${O}/><path d="M175 241 Q200 257 225 241 Q200 250 175 241 Z" fill="${W}"/>`;
const baby = `${brows(136)}
<ellipse cx="166" cy="188" rx="19" ry="21" fill="${W}" ${O}/><ellipse cx="234" cy="188" rx="19" ry="21" fill="${W}" ${O}/>
<circle cx="166" cy="192" r="13.5" fill="${H}"/><circle cx="234" cy="192" r="13.5" fill="${H}"/>
<circle cx="160" cy="185" r="5" fill="${W}"/><circle cx="228" cy="185" r="5" fill="${W}"/><circle cx="171" cy="198" r="2.2" fill="${W}"/><circle cx="239" cy="198" r="2.2" fill="${W}"/>
<ellipse cx="144" cy="228" rx="14" ry="7" fill="${BL}" opacity="0.7"/><ellipse cx="256" cy="228" rx="14" ry="7" fill="${BL}" opacity="0.7"/>
<ellipse cx="200" cy="248" rx="8" ry="9.5" fill="${L}" ${O}/>`;
const happy = `${brows(144)}
<path d="M150 194 Q168 174 186 194" stroke="${H}" stroke-width="4.5" stroke-linecap="round" fill="none"/><path d="M214 194 Q232 174 250 194" stroke="${H}" stroke-width="4.5" stroke-linecap="round" fill="none"/>
<ellipse cx="146" cy="222" rx="16" ry="9" fill="${BL}" opacity="0.85"/><ellipse cx="254" cy="222" rx="16" ry="9" fill="${BL}" opacity="0.85"/>
<path d="M162 234 Q200 292 238 234 Z" fill="${L}" ${O}/><path d="M168 236 Q200 254 232 236 Z" fill="${W}"/>`;
---
<div class:list={['character', { 'character--live': interactive }]} data-eyes={expression} style={`--size:${size}px`}>
  <svg viewBox="0 0 400 520" role="img" aria-label={label} focusable="false">
    <g class="character__breath">
      <Fragment set:html={body} />
      <g class="expr expr--follow"><Fragment set:html={follow} /></g>
      <g class="expr expr--baby"><Fragment set:html={baby} /></g>
      <g class="expr expr--happy"><Fragment set:html={happy} /></g>
    </g>
  </svg>
</div>

<style>
  .character { width: var(--size); max-width: 100%; aspect-ratio: 400 / 520; }
  .character svg { width: 100%; height: 100%; overflow: visible; }
  .expr { opacity: 0; transition: opacity 150ms ease-out; }
  .character[data-eyes='follow'] .expr--follow,
  .character[data-eyes='baby'] .expr--baby,
  .character[data-eyes='happy'] .expr--happy { opacity: 1; }
  .pupils { transition: transform 80ms linear; }
  .eye-whites, .pupils { transform-box: fill-box; transform-origin: center; }
  .character--live .character__breath { transform-origin: 200px 520px; animation: breathe 4s ease-in-out infinite; }
  .character--live .hair-front { transform-origin: 200px 80px; animation: sway 6s ease-in-out infinite; }
  .character.is-blinking .eye-whites, .character.is-blinking .pupils { transform: scaleY(0.1); transition: transform 90ms ease-in; }
  @keyframes breathe { 50% { transform: scale(1.015); } }
  @keyframes sway { 50% { transform: rotate(1deg); } }
</style>
